# ==============================================================================
# AgentShield Runtime Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT SECURITY RULES:
# - Never commit .env, credentials, API keys, or database URLs to Git.
# - Keep .env excluded via .gitignore.
# - Production deployments require a 32+ character AGENTSHIELD_ADMIN_KEY.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Operational Mode
# ------------------------------------------------------------------------------
# Deployment environment: "development", "staging", or "production"
AGENTSHIELD_ENV=development

# Read-only demonstration mode:
# - "true"  => Public demo mode: blocks all state mutations and live tool execution
# - "false" => Normal interactive mode: permits authorized execution and reviews
AGENTSHIELD_READONLY=false

# ------------------------------------------------------------------------------
# 2. Administrative Authentication & Session Security
# ------------------------------------------------------------------------------
# High-entropy secret key required for administrative access (X-Admin-Key header or UI login).
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENTSHIELD_ADMIN_KEY=your-random-admin-key-minimum-32-chars-long

# Cryptographic signing secret for HMAC-SHA256 session cookies.
# If omitted, derived automatically from AGENTSHIELD_ADMIN_KEY.
AGENTSHIELD_SESSION_SECRET=your-random-session-secret-minimum-32-chars-long

# ------------------------------------------------------------------------------
# 3. Network, CORS & Frontend Configuration
# ------------------------------------------------------------------------------
# Comma-separated list of exact allowed browser origins (no wildcards allowed).
AGENTSHIELD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend client API base URL (used by Vite dev server or standalone frontend build).
# For local dev proxy: http://localhost:8000
VITE_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 4. Storage Backend & Database Configuration
# ------------------------------------------------------------------------------
# Storage engine: "sqlite" (default for local development) or "postgres" (for production)
AGENTSHIELD_STORAGE_BACKEND=sqlite

# Local SQLite database paths (optional; defaults to local files in workspace root)
# AGENTSHIELD_AUDIT_DB=agentshield_audit.db
# AGENTSHIELD_REVIEW_DB=agentshield_reviews.db
# AGENTSHIELD_EVENTS_DB=agentshield_events.db
# AGENTSHIELD_REPORTS_DB=agentshield_reports.db
# AGENTSHIELD_SESSIONS_DB=agentshield_sessions.db
# AGENTSHIELD_SIMULATION_DB=agentshield_simulation.db

# PostgreSQL connection string (mandatory when AGENTSHIELD_STORAGE_BACKEND=postgres)
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]?sslmode=require
# AGENTSHIELD_DATABASE_URL=postgresql://user:password@hostname:5432/dbname?sslmode=require
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname?sslmode=require

# PostgreSQL connection pool settings (for multi-tenant or serverless workloads)
# AGENTSHIELD_POSTGRES_POOL_MIN=1
# AGENTSHIELD_POSTGRES_POOL_MAX=10

# ------------------------------------------------------------------------------
# 5. LLM Security Analyst & Gemini Provider
# ------------------------------------------------------------------------------
# Analyst provider: "mock" (local deterministic sandbox) or "gemini" (live Google Gemini API)
AGENTSHIELD_ANALYST_PROVIDER=mock

# Google Gemini API key (mandatory when AGENTSHIELD_ANALYST_PROVIDER=gemini)
# Obtain from Google AI Studio: https://aistudio.google.com/
# GEMINI_API_KEY=your-gemini-api-key-here

# Target Gemini model identifier (default: "gemini-2.5-flash")
# AGENTSHIELD_ANALYST_MODEL=gemini-2.5-flash

# HTTP timeout in seconds for Gemini API requests
# AGENTSHIELD_ANALYST_TIMEOUT=10.0

# Maximum retry attempts on transient network or 5xx errors
# AGENTSHIELD_ANALYST_MAX_RETRIES=2

# Maximum cumulative token budget for analyst investigations
# AGENTSHIELD_MAX_TOKEN_BUDGET=100000

# Fallback to mock analyst if Gemini is unreachable (prevents application crashes)
# Note: Deterministic PolicyEngine decisions are never altered by mock fallback.
AGENTSHIELD_ALLOW_MOCK_FALLBACK=true

# ------------------------------------------------------------------------------
# 6. Reliability, Rate Limits & Resource Budgets
# ------------------------------------------------------------------------------
# Sliding-window rate limit per agent identifier (<count>/<second|minute|hour>)
AGENTSHIELD_RATE_LIMIT_AGENT=100/minute

# Sliding-window rate limit per agent + tool combination
AGENTSHIELD_RATE_LIMIT_TOOL=60/minute

# Unauthenticated public endpoint rate limit (e.g. /health, /metrics)
AGENTSHIELD_RATE_LIMIT_PUBLIC=120/60s

# Analyst investigation request rate limit
AGENTSHIELD_RATE_LIMIT_ANALYST=20/60s

# Shared SQLite rate limiter database path (use ":memory:" for isolated memory store)
AGENTSHIELD_RATE_LIMIT_DB=:memory:

# Maximum cumulative tool calls permitted per session/correlation ID before blocking
AGENTSHIELD_MAX_TOOL_CALLS_PER_SESSION=50

# Maximum execution duration in seconds allocated to a tool callable before timeout
AGENTSHIELD_MAX_TOOL_EXECUTION_SECONDS=30.0

# Maximum byte size for tool argument payloads (default: 64 KB)
AGENTSHIELD_MAX_ARGUMENTS_BYTES=65536

# Maximum HTTP request body size handled by the API (default: 1 MB)
AGENTSHIELD_MAX_BODY_BYTES=1048576

# Loop detection thresholds (consecutive identical calls and cyclic patterns)
AGENTSHIELD_LOOP_CONSECUTIVE_LIMIT=3
AGENTSHIELD_LOOP_CYCLE_LIMIT=2

# ------------------------------------------------------------------------------
# 7. External Provider Circuit Breaker
# ------------------------------------------------------------------------------
# Number of consecutive failures before opening circuit breaker to external provider
AGENTSHIELD_CB_FAILURE_THRESHOLD=3

# Cooling period in seconds before transitioning from OPEN to HALF_OPEN state
AGENTSHIELD_CB_RECOVERY_TIMEOUT=30.0

# Number of successful test requests required in HALF_OPEN to close the circuit
AGENTSHIELD_CB_HALF_OPEN_THRESHOLD=1

# ------------------------------------------------------------------------------
# 8. Observability & Monitoring Exposure
# ------------------------------------------------------------------------------
# Require admin key for GET /metrics endpoint (false allows unauthenticated Prometheus scraping)
AGENTSHIELD_REQUIRE_AUTH_FOR_METRICS=false
